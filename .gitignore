# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local tool state
/.supabase/
/.superpowers/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# large files
*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated docs/parser cache
docs/__pycache__/
docs/far_routes.json
supabase/migrations/027_far_urls_auto.sql
